{
  "geode": "5.11.2",
  "gd": {
    "android": "2.2081"
  },
  "id": "galactic.inputbuffer",
  "name": "Galactic",
  "version": "0.2.0",
  "developer": "Galactic",
  "description": "Android64 input timing, player tracking, and prediction framework.",
  "api": "geode",
  "settings": [
    {
      "name": "enable-buffer",
      "type": "bool",
      "default": true
    },
    {
      "name": "enable-pathfinder",
      "type": "bool",
      "default": true
    },
    {
      "name": "dual-support",
      "type": "bool",
      "default": true
    },
    {
      "name": "prediction-horizon",
      "type": "int",
      "default": 30,
      "min": 1,
      "max": 240
    },
    {
      "name": "pathfinder-budget",
      "type": "int",
      "default": 256,
      "min": 32,
      "max": 2048
    }
  ]
}
